# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /d C:\Users\JORDAN~1\DOCUME~1\GitHub\POCKET~2\shell\BUILD-~1 && $(CMAKE_COMMAND) -P "C:\Users\Jordan Solans\Documents\GitHub\pockettracker - Copie\shell\build-mingw\CMakeFiles\VerifyGlobs.cmake"
	cd /d C:\Users\JORDAN~1\DOCUME~1\GitHub\POCKET~2\shell\BUILD-~1 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

